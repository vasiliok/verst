/// @file
/// Project-wide scalar types. GENERATED by CMake from src/base/vrst_types.h.in;
/// set the `VRST_TYPE_*` cache variables to change them.
#pragma once

#include <cstddef>
#include <cstdint>
#include <limits>
#include <type_traits>

namespace nav {

using Vrst_int8 = @VRST_TYPE_INT8@;        ///< Signed 8-bit integer.
using Vrst_int16 = @VRST_TYPE_INT16@;      ///< Signed 16-bit integer.
using Vrst_int32 = @VRST_TYPE_INT32@;      ///< Signed 32-bit integer.
using Vrst_int64 = @VRST_TYPE_INT64@;      ///< Signed 64-bit integer.
using Vrst_uint8 = @VRST_TYPE_UINT8@;      ///< Unsigned 8-bit integer.
using Vrst_uint16 = @VRST_TYPE_UINT16@;    ///< Unsigned 16-bit integer.
using Vrst_uint32 = @VRST_TYPE_UINT32@;    ///< Unsigned 32-bit integer.
using Vrst_uint64 = @VRST_TYPE_UINT64@;    ///< Unsigned 64-bit integer.
using Vrst_float32 = @VRST_TYPE_FLOAT32@;  ///< IEEE 754 single precision.
using Vrst_float64 = @VRST_TYPE_FLOAT64@;  ///< IEEE 754 double precision.
using Vrst_size = @VRST_TYPE_SIZE@;        ///< Size and index type of the platform (size_t).

/// True if T is an integer of exactly Bytes bytes with the given signedness.
/// Used by the static_asserts below: a wrong `VRST_TYPE_*` setting must fail here,
/// not corrupt the binary files.
template <class T, std::size_t Bytes, bool Signed>
constexpr bool is_int = std::is_integral_v<T> && sizeof(T) == Bytes && std::is_signed_v<T> == Signed;

static_assert(is_int<Vrst_int8, 1, true>, "VRST_TYPE_INT8 must be a signed 8-bit integer");
static_assert(is_int<Vrst_int16, 2, true>, "VRST_TYPE_INT16 must be a signed 16-bit integer");
static_assert(is_int<Vrst_int32, 4, true>, "VRST_TYPE_INT32 must be a signed 32-bit integer");
static_assert(is_int<Vrst_int64, 8, true>, "VRST_TYPE_INT64 must be a signed 64-bit integer");
static_assert(is_int<Vrst_uint8, 1, false>, "VRST_TYPE_UINT8 must be an unsigned 8-bit integer");
static_assert(is_int<Vrst_uint16, 2, false>, "VRST_TYPE_UINT16 must be an unsigned 16-bit integer");
static_assert(is_int<Vrst_uint32, 4, false>, "VRST_TYPE_UINT32 must be an unsigned 32-bit integer");
static_assert(is_int<Vrst_uint64, 8, false>, "VRST_TYPE_UINT64 must be an unsigned 64-bit integer");
static_assert(std::is_floating_point_v<Vrst_float32> && sizeof(Vrst_float32) == 4 &&
                  std::numeric_limits<Vrst_float32>::is_iec559,
              "VRST_TYPE_FLOAT32 must be an IEEE 754 32-bit float");
static_assert(std::is_floating_point_v<Vrst_float64> && sizeof(Vrst_float64) == 8 &&
                  std::numeric_limits<Vrst_float64>::is_iec559,
              "VRST_TYPE_FLOAT64 must be an IEEE 754 64-bit float");
static_assert(std::is_integral_v<Vrst_size> && std::is_unsigned_v<Vrst_size> && sizeof(Vrst_size) >= 4,
              "VRST_TYPE_SIZE must be an unsigned integer of at least 32 bits");

}  // namespace nav
